import React from 'react';
import { 
  Sword, 
  Flame, 
  Wind, 
  ChevronsRight, 
  MousePointer2, 
  Gamepad2,
  Plus
} from 'lucide-react';

const InputBadge = ({ type, text, icon: Icon }) => {
  const isKeyboard = type === 'keyboard';
  return (
    <div className={`flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold border-2 border-black ${
      isKeyboard 
        ? 'bg-white text-black' 
        : 'bg-black text-white'
    }`}>
      <Icon size={12} className={isKeyboard ? 'text-black' : 'text-white'} />
      {text}
    </div>
  );
};

const ActionCard = ({ title, subtitle, icon: Icon, keyboard, gamepad, iconColor, combo }) => {
  return (
    <div className="relative group bg-white border-2 border-black rounded-xl p-5 transition-all duration-300 hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-1 flex items-start gap-4">
      {/* Icon (Left Side) */}
      <div className={`shrink-0 p-3.5 rounded-full bg-white border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] ${iconColor}`}>
        <Icon size={28} strokeWidth={2} />
      </div>

      {/* Content & Inputs (Right Side) */}
      <div className="flex-1 flex flex-col text-left">
        {/* Title & Subtitle */}
        <div>
          <h3 className="text-lg font-extrabold text-black">{title}</h3>
          <p className="text-sm font-medium text-gray-600 mt-1 leading-snug">{subtitle}</p>
        </div>

        {/* Inputs */}
        <div className="mt-4 pt-4 border-t-2 border-black/10 group-hover:border-black/30 transition-colors">
          {combo ? (
            <div className="flex flex-col gap-2.5">
              <div className="flex items-center justify-start gap-1.5 flex-wrap">
                <InputBadge type="keyboard" text={combo[0].keyboard} icon={MousePointer2} />
                <Plus size={16} className="text-black font-bold" strokeWidth={3} />
                <InputBadge type="keyboard" text={combo[1].keyboard} icon={MousePointer2} />
              </div>
              <div className="flex items-center justify-start gap-1.5 flex-wrap">
                <InputBadge type="gamepad" text={combo[0].gamepad} icon={Gamepad2} />
                <Plus size={16} className="text-black font-bold" strokeWidth={3} />
                <InputBadge type="gamepad" text={combo[1].gamepad} icon={Gamepad2} />
              </div>
            </div>
          ) : (
            <div className="flex justify-start gap-2 flex-wrap">
              <InputBadge type="keyboard" text={keyboard} icon={MousePointer2} />
              <InputBadge type="gamepad" text={gamepad} icon={Gamepad2} />
            </div>
          )}
        </div>
      </div>
    </div>
  );
};

